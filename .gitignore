# ----------------------------------------------------
# تنظیمات اختصاصی پروژه RAG و فایل‌های حجیم
# ----------------------------------------------------

# ۱. نادیده‌گرفتن فایل‌های دیتابیس برداری (FAISS)
vector_store_data/*
!vector_store_data/.gitkeep

# ۲. نادیده‌گرفتن فایل‌های ورودی PDF حجیم یا فایل‌های تستی
data/*
!data/.gitkeep
!data/sample.pdf

# ۳. فایل‌های اجرایی، لاگ‌ها و متغیرهای محیطی
*.faiss
*.pkl
*.index
.env

# ۴. کش‌های مربوط به پایتون و تست
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual Environment (محیط مجازی شما و سایر فرمت‌ها)
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode (فایل‌های موقت اجرایی پایتون)
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing Cache (کش ابزارهای تست)
.pytest_cache/
.coverage
htmlcov/

# Vector Store Data (فایل‌های حجیم دیتابیس برداری فاوییس ذخیره نشوند، فقط ساختار پوشه بماند)
vector_store_data/*
!vector_store_data/.gitkeep

# PDF inputs (فایل‌های دیتای کاربر نروند، فقط پوشه و سمپل بماند)
data/*
!data/.gitkeep
!data/sample.pdf

# VS Code & Environment variables
.env
.vscode/*
!.vscode/settings.json
chroma_storage/*

models/

